<UserControl x:Class="KiddEsports.GamesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KiddEsports"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*">
            </ColumnDefinition>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgvGames" Margin="10" CanUserAddRows="False" SelectionChanged="dgvGames_SelectionChanged" IsReadOnly="True"/>

        <Button x:Name="btnDelete" Grid.Row="1" HorizontalAlignment="Left" Margin="10" Width="100" Click="btnDelete_Click">DELETE</Button>

        <Button x:Name="btnClose" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="10" Width="100" Click="btnClose_Click">CLOSE</Button>

        <StackPanel Grid.Column="1" Margin="10">

            <Label>Game Name</Label>
            <TextBox x:Name="txtGameName"></TextBox>

            <Label>Game Category</Label>
            <ComboBox x:Name="cboGameCategory"></ComboBox>
           
            <Button x:Name="btnSave" Margin="10" Click="btnSave_Click">SAVE</Button>
            <Button x:Name="btnClear" Margin="10" Click="btnClear_Click">CLEAR / CANCEL</Button>

        </StackPanel>
    </Grid>
</UserControl>
